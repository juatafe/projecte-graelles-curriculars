{
  "$schema": "https://opencode.ai/config.json",
  "model": "ollama/qwen2.5-coder:7b",
  "small_model": "ollama/qwen3:4b",
  "agent": {
    "plan": {
      "model": "ollama/deepseek-r1:7b"
    },
    "build": {
      "model": "ollama/qwen2.5-coder:7b",
      "prompt": "Respon sempre en valencià clar. No uses anglés ni castellà, excepte quan cites literalment una font. Respecta AGENTS.md i no anuncies cap fitxer creat sense comprovar-lo físicament."
    }
  },
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://127.0.0.1:11434/v1",
        "apiKey": "ollama"
      },
      "models": {
        "qwen2.5-coder:7b": {
          "name": "Qwen 2.5 Coder 7B"
        },
        "deepseek-r1:7b": {
          "name": "DeepSeek R1 7B"
        },
        "gemma3:4b": {
          "name": "Gemma 3 4B"
        },
        "qwen3:4b": {
          "name": "Qwen 3 4B"
        },
        "qwen3:8b": {
          "name": "Qwen 3 8B"
        }
      }
    }
  }
}
